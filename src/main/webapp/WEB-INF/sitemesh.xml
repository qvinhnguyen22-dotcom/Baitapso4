<?xml version="1.0" encoding="UTF-8"?>
<sitemesh>
    <mapping path="/admin" decorator="/WEB-INF/decorators/admin.jsp" />
    <mapping path="/admin/*" decorator="/WEB-INF/decorators/admin.jsp" />
    <mapping path="/admin/**" decorator="/WEB-INF/decorators/admin.jsp" />
    <mapping path="/*" decorator="/WEB-INF/decorators/web.jsp" />

    <mapping path="/login" excluded="true" />
    <mapping path="/register" excluded="true" />
    <mapping path="/verify-otp" excluded="true" />
    <mapping path="/forgot-password" excluded="true" />
    <mapping path="/reset-password" excluded="true" />
    <mapping path="/assets/*" excluded="true" />
    <mapping path="/image" excluded="true" />
    <mapping path="/image/*" excluded="true" />
</sitemesh>